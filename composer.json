{
    "name": "cgservices/secrets_cli_php",
    "description": "Loads environment variables from `.env` to `getenv()`, `$_ENV` and `$_SERVER` automagically.",
    "keywords": ["vault", "dotenv", "environment"],
    "license" : "BSD-3-Clause-Attribution",
    "authors" : [
        {
            "name": "Sander van Rossum",
            "email": "sander.van.rossum@cg.nl",
            "homepage": "https://github.com/cgservices/secrets_cli_php"
        }
    ],
    "require": {
        "php": "^8.4",
        "corneltek/cliframework": "^2.5",
        "jippi/vault-php-sdk": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "bin": [
        "bin/secrets"
    ],
    "autoload": {
        "psr-4": {
            "SecretsCli\\": "src/"
        }
    }
}
