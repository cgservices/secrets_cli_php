#!/usr/bin/env php
<?php

  $loader = require_once 'vendor/autoload.php';
  $loader->add('SecretsCli','src');

  $app = new \SecretsCli\Application();

  if(file_exists(getcwd() .'/.secrets')) {
    $dotenv = Dotenv\Dotenv::createImmutable(getcwd(), '.secrets');
    $dotenv->safeLoad();

    $key = $_ENV['SECRETS_STORAGE_KEY'] ?? getenv('SECRETS_STORAGE_KEY');
    $file = $_ENV['SECRETS_FILE'] ?? getenv('SECRETS_FILE');

    if(!empty($key)) {
      \SecretsCli\Application::$secrets_key = $key;
    }

    if(!empty($file)) {
      \SecretsCli\Application::$secrets_file = $file;
    }
  } else {
    $app->warning('Secrets not yet initialized...');
  }

  $app->run($argv);
